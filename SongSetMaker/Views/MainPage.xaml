<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SongSetMaker.ViewModels"
             x:Class="SongSetMaker.Views.MainPage"
             BackgroundColor="Navy"               
             Title="Song Library">

        

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add Song" IconImageSource="add.png" Clicked="OnAddSongClicked" Order="Primary" Priority="0" />
        <ToolbarItem Text="Export"   Order="Secondary" Priority="1" Command="{Binding ExportDatabaseCommand}" />
        <ToolbarItem Text="Import"   Order="Secondary" Priority="2" Command="{Binding ImportDatabaseCommand}" />
        <ToolbarItem Text="About"    Order="Secondary" Priority="3" Command="{Binding ShowAboutCommand}" />
    </ContentPage.ToolbarItems>

    <!---
        <ToolbarItem IconImageSource="download.png"
         Text="Download Songs"
         Command="{Binding DownloadSongsCommand}" />
    -->

    <Grid x:Name="RootGrid" Padding="10" RowDefinitions="Auto, Auto, *">
        <!-- ✅ Row 0: Search + Key Filter -->
        <Grid Grid.Row="0"
          ColumnDefinitions="4*,Auto,Auto"
          ColumnSpacing="10"
          RowDefinitions="Auto"
        >

            <!-- ✅ Search Bar -->
            <SearchBar Grid.Column="0" 
                   Placeholder="Search songs..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding PerformSearchCommand}"
                   SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}"
                   BackgroundColor="White"
                   TextColor="Black"
                   HorizontalOptions="Fill"/>

            <Picker Grid.Column="1" 
                    ItemsSource="{Binding Keys}"
                    SelectedItem="{Binding SelectedKey}"
                    BackgroundColor="White"
                    TextColor="Black"
                    HorizontalOptions="End"/>

            <Picker Grid.Column="2"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    BackgroundColor="White"
                    TextColor="Black"
                    HorizontalOptions="End"/>

        </Grid>

        <Label Grid.Row="1" Grid.Column="0"
               Text="{Binding SongCount, StringFormat='Total Songs: {0}'}"
               TextColor="White"
               FontSize="16"
               Margin="0,5,0,5" />

        <Label Grid.Row="1" Grid.Column="1"
               Text="Loading history..."
               TextColor="Yellow"
               FontAttributes="Bold"
               FontSize="16"
               IsVisible="{Binding IsHistoryLoading}"
               VerticalOptions="Center"
               HorizontalOptions="Center"/>

        <CollectionView Grid.Column="0" 
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Always"
                            ItemsSource="{Binding FilteredSongs}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <Border Margin="5"
                                BackgroundColor="Ivory"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto"
                                  ColumnDefinitions="*, Auto"
                                  RowSpacing="5"
                                  ColumnSpacing="10"
                                  Padding="12">


                                <!-- Song Title + Add Button -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       TextColor="Black"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center" />

                                <ImageButton Grid.Row="0" Grid.Column="1"
                                             BackgroundColor="Transparent"
                                             Source="menu_big.png"
                                             HeightRequest="20"
                                             WidthRequest="20"
                                             Margin="5"
                                             Padding="8"
                                             Clicked="OnMenuButtonClicked" >
                                    <FlyoutBase.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play Song"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=PlayYouTubeCommand}" 
                                                            CommandParameter="{Binding .}" />
                                            <MenuFlyoutItem Text="View Chords"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=OpenChordSheetCommand}"
                                                            CommandParameter="{Binding .}" />
                                            <MenuFlyoutItem Text="View Scripture"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=OpenScriptureCommand}"
                                                            CommandParameter="{Binding .}" />

                                            <MenuFlyoutSeparator />

                                            <MenuFlyoutItem Text="History"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=OpenHistoryCommand}"
                                                            CommandParameter="{Binding .}"
                                                            IsEnabled="True" />
                                        </MenuFlyout>
                                    </FlyoutBase.ContextFlyout>
                                </ImageButton>

                                <!-- Key/Tempo/Timing Info Row -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Key: " FontAttributes="Bold" FontSize="20" TextColor="Black"/>
                                            <Span Text="{Binding Key}" FontSize="20" FontAttributes="Bold" TextColor="#1565C0"/>
                                            <Span Text=" - Tempo: " FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                            <Span Text="{Binding Tempo}" FontSize="18" FontAttributes="Bold" TextColor="#1565C0"/>
                                            <Span Text=" - " FontAttributes="Bold" TextColor="Black"/>
                                            <Span Text="{Binding Timing}" FontSize="18" FontAttributes="Bold" TextColor="#1565C0"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <ImageButton Grid.Row="1" Grid.Column="1"                                         
                                        Source="delete.png" 
                                        BackgroundColor="Transparent"
                                        HeightRequest="20"
                                        WidthRequest="20"
                                        Margin="5"
                                        Padding="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, 
                                                          Path=RemoveSongCommand}"
                                        CommandParameter="{Binding .}">
                                </ImageButton>

                                <!-- Artist Info Row -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Artist: " FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                            <Span Text="{Binding Artist}" FontSize="18" FontAttributes="Bold" TextColor="BlueViolet"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!-- Artist / CCCLI# Info Row -->
                                <Label Grid.Row="3" Grid.Column="0"
                                       VerticalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="CCLI# " FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                            <Span Text="{Binding CcliNum}" FontSize="18" FontAttributes="Bold" TextColor="BlueViolet"/>
                                            <Span Text=" Scripture " FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                            <Span Text="{Binding Scripture}" FontSize="18" FontAttributes="Bold" TextColor="DarkRed"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <ImageButton Grid.Row="3" Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Source="add_big.png" 
                                        HeightRequest="20"
                                        WidthRequest="20"
                                        Margin="5"
                                        Padding="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, 
                                                          Path=AddToMySetCommand}"
                                        CommandParameter="{Binding .}">
                                </ImageButton>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="0" Grid.Column="1"
                           IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           Color="{StaticResource Primary}" 
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>


</ContentPage>
    