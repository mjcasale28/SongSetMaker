<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SongSetMaker.Views.AddSongPopup"
             >

    <ScrollView>
        <VerticalStackLayout 
            Padding="5" 
            Spacing="10"
            BackgroundColor="Ivory">

            <Label Text="{Binding PageTitle}"
               FontSize="20"
               HorizontalOptions="Center"
               TextColor="Black"
               FontAttributes="Bold" />

            <Grid
                ColumnDefinitions="Auto, *"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10"
                ColumnSpacing="12">
                
                <!-- Row 0 -->
                <Label Grid.Row="0" Grid.Column="0" 
                       Text="Title" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="0" Grid.Column="1" 
                       Placeholder="Enter song title" 
                       Text="{Binding Title}" 
                       TextColor="Black" />

                <!-- Row 1 -->
                <Label Grid.Row="1" Grid.Column="0" 
                       Text="Artist" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="1" Grid.Column="1" 
                       Placeholder="Enter songwriter(s)" 
                       Text="{Binding Artist}" 
                       TextColor="Black" />

                <!-- Row 2 -->
                <Label Grid.Row="2" Grid.Column="0" 
                       Text="Lead Singer" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="2" Grid.Column="1" 
                       Placeholder="Main vocalist" 
                       Text="{Binding LeadSinger}" 
                       TextColor="Black" />

                <!-- Row 3 -->
                <Label Grid.Row="3" Grid.Column="0" 
                       Text="Key" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="3" Grid.Column="1" 
                       Placeholder="e.g. G, C, Em" 
                       Text="{Binding Key}" 
                       TextColor="Black" />

                <!-- Row 4 -->
                <Label Grid.Row="4" Grid.Column="0" 
                       Text="Tempo" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="4" Grid.Column="1" 
                       Placeholder="e.g. 78" 
                       Keyboard="Numeric" 
                       Text="{Binding Tempo}" 
                       TextColor="Black" />

                <!-- Row 5 -->
                <Label Grid.Row="5" Grid.Column="0" 
                       Text="CCLI #" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="5" Grid.Column="1" 
                       Placeholder="CCLI number if registered" 
                       Keyboard="Numeric" 
                       Text="{Binding CcliNum}" 
                       TextColor="Black" />

                <!-- Row 6 -->
                <Label Grid.Row="6" Grid.Column="0" 
                       Text="Timing" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="6" Grid.Column="1" 
                       Placeholder="e.g. 4/4, 6/8" 
                       Text="{Binding Timing}" 
                       TextColor="Black" />

                <!-- Row 7 -->
                <Label Grid.Row="7" Grid.Column="0" 
                       Text="Theme" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="7" Grid.Column="1" 
                       Placeholder="e.g. Grace, Worship, Hope" 
                       Text="{Binding Theme}" 
                       TextColor="Black" />

                <!-- Row 8 -->
                <Label Grid.Row="8" Grid.Column="0" 
                       Text="YouTube URL" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="8" Grid.Column="1" 
                       Placeholder="https://youtube.com/..." 
                       Text="{Binding YouTubeUrl}" 
                       TextColor="Black" 
                       Keyboard="Url" />

                <!-- Row 9 -->
                <Label Grid.Row="9" Grid.Column="0" 
                       Text="Chord Sheet URL" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="9" Grid.Column="1" 
                       Placeholder="Link to chords" 
                       Text="{Binding ChordSheetUrl}" 
                       TextColor="Black" 
                       Keyboard="Url" />

                <!-- Row 10 -->
                <Label Grid.Row="10" Grid.Column="0" 
                       Text="Song Date" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="10" Grid.Column="1" 
                       Placeholder="yyyy-MM-dd" 
                       Text="{Binding SongDate}" 
                       TextColor="Black" />
                
                <!-- Row 11 -->
                <Label Grid.Row="11" Grid.Column="0" 
                       Text="Scripture Ref" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="11" Grid.Column="1" 
                       Placeholder="e.g. John 3:16" 
                       Text="{Binding Scripture}" 
                       TextColor="Black" />
                
                <!-- Row 12 -->
                <Label Grid.Row="12" Grid.Column="0" 
                       Text="Scripture URL" 
                       VerticalOptions="Center" 
                       TextColor="Black" FontAttributes="Bold" />
                <Entry Grid.Row="12" Grid.Column="1" 
                       Placeholder="Link to Scriptures" 
                       Text="{Binding ScriptureUrl}" 
                       TextColor="Black" 
                       Keyboard="Url" />
            </Grid>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Cancel"
                    BackgroundColor="{AppThemeBinding Light=#0078D4, Dark=#3399FF}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48" 
                    Clicked="OnCancelClicked" />

                <Button Text="Save Song"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{AppThemeBinding Light=#0078D4, Dark=#3399FF}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48" />
                
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>