<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SongSetMaker.Views.SongMenuPopup"
    Padding="0">

    <VerticalStackLayout Padding="5" Spacing="10"
                         WidthRequest="300" 
                         HeightRequest="300"
                         BackgroundColor="Ivory"
                         >

        <Label Text="{Binding Title}"
               FontSize="20"
               HorizontalOptions="Center"
               TextColor="Black"
               FontAttributes="Bold" />

        <Button Text="YouTube"
                HorizontalOptions="Center"
                Command="{Binding OpenYouTubeCommand}" />

        <Button Text="Chords"
                HorizontalOptions="Center"
                Command="{Binding OpenChordSheetCommand}" />

        <Button Text="Scripture"
                HorizontalOptions="Center"
                Command="{Binding OpenScriptureCommand}" />

        <Button Text="History"
                HorizontalOptions="Center"
                Command="{Binding OpenHistoryCommand}" />

    </VerticalStackLayout>

</toolkit:Popup>
