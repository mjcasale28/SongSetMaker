<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SongSetMaker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SongSetMaker.Views"
    xmlns:viewmodels="clr-namespace:SongSetMaker.ViewModels"
    Shell.BackgroundColor="Navy"
    Shell.TitleColor="White"
    Shell.ForegroundColor="{OnPlatform Android=White, WinUI=White}"
    >
    <Shell.NavBarIsVisible>true</Shell.NavBarIsVisible>
    <TabBar>
        <Tab Title="Home">
            <ShellContent Title="All Songs"
                         Icon="lyrics.png"
                         ContentTemplate="{DataTemplate views:MainPage}" />

            <ShellContent Title="Song Set"
                         Icon="build.png"
                         ContentTemplate="{DataTemplate views:MySetPage}" />
        </Tab>
    </TabBar>
</Shell>


